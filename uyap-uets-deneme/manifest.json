{
  "manifest_version": 3,
  "name": "Hukuk Bürosu — UYAP ve UETS Eklentisi",
  "version": "0.2.0",
  "description": "Hukuk bürosu UYAP ve UETS bağlantısı ve veri senkronizasyonu.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://avukat.uyap.gov.tr/*",
    "https://avukatbeta.uyap.gov.tr/*",
    "https://*.etebligat.gov.tr/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/portal-inceleme/baglanti/*",
        "https://*/portal-inceleme/baglanti/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://avukat.uyap.gov.tr/*",
        "https://avukatbeta.uyap.gov.tr/*",
        "https://ptt.etebligat.gov.tr/*"
      ],
      "js": [
        "account-name.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://avukat.uyap.gov.tr/*",
        "https://avukatbeta.uyap.gov.tr/*",
        "https://ptt.etebligat.gov.tr/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://avukat.uyap.gov.tr/*",
        "https://avukatbeta.uyap.gov.tr/*",
        "https://ptt.etebligat.gov.tr/*"
      ],
      "js": [
        "auto.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
