# Production için örnek; değerleri sunucudaki .env dosyasına yazın. Bu dosyaya gerçek değer koymayın.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
MEDIA_ROOT=
STATIC_ROOT=
LOG_FILE=

# Yedekleme (production değerleri kurulumda .env içine yazılır)
BACKUP_PASSWORD=
BACKUP_DIR=
PG_DUMP=
PG_RESTORE=
BACKUP_DATABASE_URL=
